POSTGRES_DB=ac_metrics
POSTGRES_USER=ac_metrics
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AC_DATABASE_URL=postgresql+psycopg://ac_metrics:replace-with-a-long-random-database-password@db:5432/ac_metrics
AC_EDGE_API_TOKEN=replace-with-a-long-random-edge-token-at-least-32-characters
AC_LOG_LEVEL=INFO
AC_PORT=8080

# Trusted-LAN Pi control endpoint used by the dashboard's "Sync from Pi" button.
AC_PI_API_URL=http://192.168.0.32:8787
AC_PI_API_TOKEN=replace-with-a-separate-long-random-pi-control-token
AC_PI_SYNC_TIMEOUT_SECONDS=120
AC_PI_STATUS_TIMEOUT_SECONDS=8
AC_PI_STATUS_INTERVAL_SECONDS=3600
AC_TELEMETRY_STALE_SECONDS=900

# On Synology, uncomment this and use a directory on a persistent shared volume.
# Create the directory before starting Compose and restrict access to administrators.
# AC_POSTGRES_DATA_PATH=/volume1/docker/ac_metrics/postgres
